# Local storage (SafeView runtime)
# UWAGA: leading slash KONIECZNY — bez niego reguła matchuje "storage" na dowolnej
# głębokości, a przy core.ignoreCase=true (macOS default) łapie też "Storage/"
# w drzewie src/, ukrywając np. SafeView.Application/Abstractions/Storage/IFileStore.cs.
/storage/
/mediamtx-data/
/logs/
/.safeview.pid

# Publish (dotnet publish output) — anchor żeby nie kolidował z ewent. folderami "Out/" "Publish/" w src
/publish/
/out/
*.pubxml.user

# Webpage marketing media (large videos/photos kept outside repo)
documentation/webpage/media/
