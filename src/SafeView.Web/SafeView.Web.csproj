<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>safeview-web-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime overrides: UI-editable config. Copy to output so reloadOnChange works. -->
    <None Update="appsettings.Runtime.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeView.Domain\SafeView.Domain.csproj" />
    <ProjectReference Include="..\SafeView.Application\SafeView.Application.csproj" />
    <ProjectReference Include="..\SafeView.Infrastructure\SafeView.Infrastructure.csproj" />
    <ProjectReference Include="..\SafeView.ML\SafeView.ML.csproj" />
    <ProjectReference Include="..\SafeView.LLM\SafeView.LLM.csproj" />
    <ProjectReference Include="..\SafeView.Notifications\SafeView.Notifications.csproj" />
    <ProjectReference Include="..\SafeView.Cameras\SafeView.Cameras.csproj" />
    <ProjectReference Include="..\SafeView.Reports\SafeView.Reports.csproj" />
    <ProjectReference Include="..\SafeView.Roboflow\SafeView.Roboflow.csproj" />
    <ProjectReference Include="..\SafeView.Licensing\SafeView.Licensing.csproj" />
    <ProjectReference Include="..\SafeView.Security\SafeView.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.MongoDB" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

</Project>
