<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>safeview-web-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime overrides: UI-editable config. Copy to output so reloadOnChange works. -->
    <None Update="appsettings.Runtime.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeView.Domain\SafeView.Domain.csproj" />
    <ProjectReference Include="..\SafeView.Application\SafeView.Application.csproj" />
    <ProjectReference Include="..\SafeView.Infrastructure\SafeView.Infrastructure.csproj" />
    <ProjectReference Include="..\SafeView.ML\SafeView.ML.csproj" />
    <ProjectReference Include="..\SafeView.LLM\SafeView.LLM.csproj" />
    <ProjectReference Include="..\SafeView.Notifications\SafeView.Notifications.csproj" />
    <ProjectReference Include="..\SafeView.Cameras\SafeView.Cameras.csproj" />
    <ProjectReference Include="..\SafeView.Reports\SafeView.Reports.csproj" />
    <ProjectReference Include="..\SafeView.Roboflow\SafeView.Roboflow.csproj" />
    <ProjectReference Include="..\SafeView.Licensing\SafeView.Licensing.csproj" />
    <ProjectReference Include="..\SafeView.Security\SafeView.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.MongoDB" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <!--
    StampBuildInfo — generuje obj/.../BuildInfo.g.cs przy każdym buildzie.
    Format Version: yyMMdd.HHmm (czas LOKALNY) — łatwo odczytać w UI z którego buildu się testuje.
    BuildDateUtc: pełen timestamp UTC do tooltipa.
    GitSha: 8-znakowy short hash z `git rev-parse`. Fallback "unknown" gdy build poza repo (CI w shallow checkout, tarball).

    Encoding MSBuild: %3B = ; , %22 = "
    Plik trafia do obj/ (już ignored przez [Oo]bj/) — nigdy nie commitujemy.
    Brak Inputs/Outputs = regeneracja co build (chcemy świeży timestamp).
  -->
  <Target Name="StampBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_BuildVersion>$([System.DateTime]::Now.ToString("yyMMdd.HHmm"))</_BuildVersion>
      <_BuildDateUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_BuildDateUtc>
    </PropertyGroup>
    <Exec Command="git rev-parse --short=8 HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitShaExitCode" />
    </Exec>
    <PropertyGroup>
      <_GitSha Condition="'$(_GitShaExitCode)' != '0' or '$(_GitSha)' == ''">unknown</_GitSha>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Include="// AUTO-GENERATED by StampBuildInfo MSBuild target — regenerated every build." />
      <_BuildInfoLines Include="// File lives under obj/ (already gitignored). Do not commit, do not edit." />
      <_BuildInfoLines Include="namespace SafeView.Web%3B" />
      <_BuildInfoLines Include="internal static class BuildInfo" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    public const string Version = %22$(_BuildVersion)%22%3B" />
      <_BuildInfoLines Include="    public const string BuildDateUtc = %22$(_BuildDateUtc)%22%3B" />
      <_BuildInfoLines Include="    public const string GitSha = %22$(_GitSha)%22%3B" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs"
                      Lines="@(_BuildInfoLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="false" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

</Project>
