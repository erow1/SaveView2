@page "/account/password"
@attribute [Authorize]
@inject SafeView.Security.Auth.IAuthService Auth
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@rendermode InteractiveServer

<PageTitle>@L["ChangePassword.Title"] — @L["AppName"]</PageTitle>

<MudStack Class="pa-4" Style="max-width:500px;" Spacing="3">
    <MudText Typo="Typo.h5">@L["ChangePassword.Title"]</MudText>

    <MudTextField @bind-Value="_current" Label="@L["ChangePassword.Current"]" InputType="InputType.Password" Variant="Variant.Outlined" />
    <MudTextField @bind-Value="_new" Label="@L["ChangePassword.New"]" InputType="InputType.Password" Variant="Variant.Outlined"
                  HelperText="Minimum 10 znaków." />
    <MudTextField @bind-Value="_confirm" Label="@L["ChangePassword.Confirm"]" InputType="InputType.Password" Variant="Variant.Outlined" />

    <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">
        Zmień hasło
    </MudButton>
</MudStack>

@code {
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _confirm = string.Empty;
    private bool _busy;

    private async Task Submit()
    {
        if (_new.Length < 10) { Snackbar.Add("Nowe hasło musi mieć min. 10 znaków.", Severity.Error); return; }
        if (_new != _confirm) { Snackbar.Add("Hasła nie są identyczne.", Severity.Error); return; }

        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userId)) { Snackbar.Add("Sesja wygasła.", Severity.Error); return; }

        _busy = true;
        try
        {
            var ok = await Auth.ChangePasswordAsync(userId, _current, _new);
            if (ok)
            {
                Snackbar.Add("Hasło zmienione — zaloguj się ponownie.", Severity.Success);
                Nav.NavigateTo("/auth/logout", forceLoad: true);
            }
            else
            {
                Snackbar.Add("Nieprawidłowe aktualne hasło.", Severity.Error);
            }
        }
        finally { _busy = false; }
    }
}
