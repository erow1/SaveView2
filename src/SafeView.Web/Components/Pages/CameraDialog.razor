@namespace SafeView.Web.Components.Pages
@using SafeView.Domain.Cameras
@using SafeView.Cameras.Vendors
@using SafeView.Application.Abstractions.Storage
@inject IStringLocalizer<SharedResource> L
@inject IFileStore Files
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="Camera.Name" Label="@L["CameraDialog.Name"]" Required="true" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="Camera.Description" Label="@L["CameraDialog.Description"]" Variant="Variant.Outlined" Lines="2" />
            <MudTextField @bind-Value="Camera.Location" Label="@L["CameraDialog.LocationZone"]" Variant="Variant.Outlined" />

            <MudDivider />
            <MudText Typo="Typo.subtitle2">@L["CameraDialog.Connection"]</MudText>

            <MudStack Row="true" Spacing="2">
                <MudSelect T="CameraVendor" Value="Camera.Vendor" ValueChanged="OnVendorChanged"
                           Label="@L["CameraDialog.Vendor"]" Variant="Variant.Outlined" Style="flex:1;">
                    @foreach (var v in Enum.GetValues<CameraVendor>())
                    {
                        <MudSelectItem Value="v">@VendorLabel(v)</MudSelectItem>
                    }
                </MudSelect>
                @if (Camera.Vendor is not CameraVendor.FileSource)
                {
                    <MudSelect T="CameraStreamProfile" Value="Camera.StreamProfile" ValueChanged="OnProfileChanged"
                               Label="@L["CameraDialog.Stream"]" Variant="Variant.Outlined" Style="flex:1;"
                               Disabled="@(Camera.Vendor == CameraVendor.Custom)">
                        <MudSelectItem Value="CameraStreamProfile.Main">@L["CameraDialog.StreamMain"]</MudSelectItem>
                        <MudSelectItem Value="CameraStreamProfile.Sub">@L["CameraDialog.StreamSub"]</MudSelectItem>
                    </MudSelect>
                }
            </MudStack>

            @if (Camera.Vendor == CameraVendor.FileSource)
            {
                <!-- File / image upload -->
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="sv-text-secondary">
                        @L["CameraDialog.FileSourcePath"]:
                        <span class="mono">@(string.IsNullOrEmpty(_uploadedFileName) ? L["CameraDialog.FileNotSelected"].Value : _uploadedFileName)</span>
                    </MudText>
                    <MudSpacer />
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadMediaFile"
                                   Accept="@_acceptedExtensions" MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton HtmlTag="label" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.UploadFile"
                                       Disabled="_uploading">
                                @(_uploading ? L["CameraDialog.FileUploading"] : L["CameraDialog.FileSelectButton"])
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </MudStack>

                @if (_uploading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }

                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                    @L["CameraDialog.FileSourceInfo"]
                </MudAlert>
            }
            else if (Camera.Vendor != CameraVendor.Custom)
            {
                <MudStack Row="true" Spacing="2">
                    <MudTextField @bind-Value="Camera.Host" Label="@L["CameraDialog.HostIp"]" Required="true"
                                  Variant="Variant.Outlined" Style="flex:2;" Placeholder="192.168.1.10" />
                    <MudNumericField T="int" Value="Camera.Port" ValueChanged="OnPortChanged"
                                     Label="@L["CameraDialog.Port"]" Min="1" Max="65535" Variant="Variant.Outlined" Style="flex:1;" />
                    <MudNumericField @bind-Value="Camera.Channel" Label="@L["CameraDialog.Channel"]" Min="1" Max="64"
                                     Variant="Variant.Outlined" Style="flex:1;"
                                     Disabled="@(!ChannelApplicable(Camera.Vendor))" />
                </MudStack>
                <MudStack Row="true" Spacing="2">
                    <MudTextField @bind-Value="Camera.Username" Label="@L["CameraDialog.Login"]" Variant="Variant.Outlined" Style="flex:1;" />
                    <MudTextField @bind-Value="Camera.Password" Label="@L["Auth.Password"]" Variant="Variant.Outlined"
                                  InputType="InputType.Password" Style="flex:1;" />
                </MudStack>

                <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true" Variant="Variant.Outlined">
                    <span class="sv-text-muted" style="font-size:11px;">@L["CameraDialog.Template"] (@Camera.Vendor):</span><br />
                    <span class="mono sv-text-info" style="font-size:12px; word-break:break-all;">
                        @VendorRtspBuilder.DescribeTemplate(Camera.Vendor, Camera.StreamProfile)
                    </span>
                </MudAlert>
            }
            else
            {
                <MudTextField @bind-Value="Camera.SourceUrl" Label="@L["CameraDialog.SourceUrl"]" Required="true"
                              Variant="Variant.Outlined"
                              HelperText="@L["CameraDialog.SourceUrlHint"]"
                              Immediate="true" TextChanged="_ => RefreshPreview()" />
            }

            <MudPaper Class="pa-2 sv-card" Elevation="0" Style="border-style:dashed;">
                <MudText Typo="Typo.caption" Class="sv-text-muted">@L["CameraDialog.ComputedUrl"]</MudText>
                <MudText Class="mono sv-status-ok" Style="font-size:12px; word-break:break-all;">
                    @(string.IsNullOrEmpty(_previewUrl) ? L["CameraDialog.FillHostLogin"].Value : _previewUrl)
                </MudText>
            </MudPaper>

            <MudDivider />
            <MudText Typo="Typo.subtitle2">@L["CameraDialog.Sampling"]</MudText>
            <MudStack Row="true" Spacing="4">
                <MudNumericField @bind-Value="Camera.SnapshotIntervalSeconds" Label="@L["CameraDialog.SnapshotInterval"]" Min="1" Max="3600" Variant="Variant.Outlined" />
                <MudNumericField @bind-Value="Camera.IncidentClipSeconds" Label="@L["CameraDialog.ClipDuration"]" Min="3" Max="120" Variant="Variant.Outlined" />
            </MudStack>

            <MudSwitch @bind-Value="Camera.Enabled" Color="Color.Success" Label="@L["CameraDialog.EnabledLabel"]" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L["Common.Cancel"]</MudButton>
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Disabled="!Valid()">@L["Common.Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Camera Camera { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    private string _previewUrl = string.Empty;
    private string _uploadedFileName = string.Empty;
    private bool _uploading;
    private const string _acceptedExtensions = ".mp4,.mkv,.avi,.mov,.webm,.jpg,.jpeg,.png,.bmp,.webp";
    private const long MaxFileSize = 2L * 1024 * 1024 * 1024; // 2 GB

    protected override void OnInitialized()
    {
        if (IsNew && Camera.Port == 0) Camera.Port = VendorRtspBuilder.DefaultPort(Camera.Vendor);

        // If editing existing file-source camera, show the filename
        if (Camera.Vendor == CameraVendor.FileSource && !string.IsNullOrEmpty(Camera.SourceUrl))
            _uploadedFileName = Path.GetFileName(Camera.SourceUrl);

        RefreshPreview();
    }

    private void OnVendorChanged(CameraVendor v)
    {
        Camera.Vendor = v;

        if (v == CameraVendor.FileSource)
        {
            Camera.Transport = CameraTransport.File;
        }
        else
        {
            Camera.Transport = CameraTransport.Rtsp;
            Camera.Port = VendorRtspBuilder.DefaultPort(v);
        }

        RefreshPreview();
    }

    private void OnProfileChanged(CameraStreamProfile p)
    {
        Camera.StreamProfile = p;
        RefreshPreview();
    }

    private void OnPortChanged(int p)
    {
        Camera.Port = p;
        RefreshPreview();
    }

    private void RefreshPreview()
    {
        _previewUrl = Camera.Vendor is CameraVendor.Custom or CameraVendor.FileSource
            ? (Camera.SourceUrl ?? string.Empty)
            : VendorRtspBuilder.Build(Camera);
    }

    private bool Valid()
    {
        if (string.IsNullOrWhiteSpace(Camera.Name)) return false;
        if (Camera.SnapshotIntervalSeconds <= 0) return false;

        if (Camera.Vendor == CameraVendor.FileSource)
            return !string.IsNullOrWhiteSpace(Camera.SourceUrl);

        if (Camera.Vendor == CameraVendor.Custom)
            return !string.IsNullOrWhiteSpace(Camera.SourceUrl);

        return !string.IsNullOrWhiteSpace(Camera.Host);
    }

    private async Task UploadMediaFile(IBrowserFile file)
    {
        if (file is null) return;

        if (file.Size > MaxFileSize)
        {
            Snackbar.Add(string.Format(L["CameraDialog.FileTooLarge"], file.Size / 1024 / 1024), Severity.Error);
            return;
        }

        _uploading = true;
        StateHasChanged();

        try
        {
            // Sanitize filename, prepend GUID to avoid collisions
            var safeName = string.Concat(file.Name.Where(c => char.IsLetterOrDigit(c) || c is '.' or '_' or '-'));
            if (string.IsNullOrEmpty(safeName)) safeName = "media.mp4";
            var relPath = $"{Guid.NewGuid():N}_{safeName}";

            await using var stream = file.OpenReadStream(MaxFileSize);
            await Files.SaveAsync(FileKind.CameraMedia, relPath, stream);

            // Set SourceUrl to absolute path so ffmpeg / MediaMTX can read it
            var absolutePath = Files.ResolveAbsolutePath(FileKind.CameraMedia, relPath);
            Camera.SourceUrl = absolutePath;
            _uploadedFileName = file.Name;

            Snackbar.Add(string.Format(L["CameraDialog.FileUploaded"], file.Name), Severity.Success);
            RefreshPreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["CameraDialog.FileUploadError"], ex.Message), Severity.Error);
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private void Save()
    {
        if (Camera.Vendor == CameraVendor.FileSource)
        {
            Camera.Transport = CameraTransport.File;
        }
        else
        {
            if (Camera.Vendor != CameraVendor.Custom)
                Camera.SourceUrl = VendorRtspBuilder.Build(Camera);
            Camera.Transport = CameraTransport.Rtsp;
        }

        if (string.IsNullOrWhiteSpace(Camera.MediaMtxPath))
        {
            var seed = !string.IsNullOrEmpty(Camera.Id) ? Camera.Id : Guid.NewGuid().ToString("N");
            Camera.MediaMtxPath = SafeView.Cameras.MediaMtxManager.SanitizePath("cam_" + seed[..Math.Min(8, seed.Length)]);
        }

        MudDialog.Close(DialogResult.Ok(Camera));
    }

    private static bool ChannelApplicable(CameraVendor v) =>
        v is CameraVendor.Dahua or CameraVendor.Hikvision;

    private string VendorLabel(CameraVendor v) => v switch
    {
        CameraVendor.Custom     => L["CameraDialog.CustomUrl"],
        CameraVendor.FileSource => L["CameraDialog.FileSource"],
        CameraVendor.Dahua      => "Dahua",
        CameraVendor.Hikvision  => "Hikvision",
        CameraVendor.Axis       => "Axis",
        CameraVendor.Bosch      => "Bosch",
        CameraVendor.Samsung    => "Samsung / Hanwha Wisenet",
        CameraVendor.ReCamera   => "reCamera (Seeed Studio)",
        _ => v.ToString()
    };
}
