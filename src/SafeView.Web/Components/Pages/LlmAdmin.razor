@page "/admin/llm"
@attribute [Authorize(Policy = "perm:llm:configure")]
@inject Microsoft.Extensions.Options.IOptionsMonitor<SafeView.LLM.LlmOptions> LlmOpts
@inject SafeView.Application.Abstractions.LLM.IChatClient Chat
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@rendermode InteractiveServer

<PageTitle>LLM — SafeView</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Konfiguracja LLM</MudText>

    <MudPaper Class="pa-4 sv-card" Elevation="0">
        <MudText Typo="Typo.h6">Aktualne ustawienia (read-only — z appsettings)</MudText>
        <MudGrid Class="mt-2">
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="Backend" Value="@_opts.Backend" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="@L["LlmAdmin.DefaultModel"]" Value="@_opts.DefaultModel" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="BaseUrl" Value="@_opts.BaseUrl" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="API Key" Value="@(_opts.ApiKey is null ? "(brak)" : "***")" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="Timeout (s)" Value="@_opts.TimeoutSeconds.ToString()" ReadOnly="true" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Class="mt-2 sv-text-muted">
            Edytuj <span class="mono">appsettings.json</span> sekcję <span class="mono">Llm</span> i zrestartuj aplikację, aby zmienić.
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 sv-card" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">Test backendu</MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Speed" Variant="Variant.Outlined"
                       OnClick="PingAsync" Disabled="_busy">Ping</MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.PlayArrow" Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="EchoAsync" Disabled="_busy">Wyślij testowy prompt</MudButton>
        </MudStack>

        @if (_pingResult is not null)
        {
            <MudAlert Severity="@(_pingResult.Value ? Severity.Success : Severity.Error)" Class="mt-3" Variant="Variant.Outlined">
                Backend @(_pingResult.Value ? "dostępny" : "nieosiągalny") (@Chat.Backend)
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(_echoOut))
        {
            <MudPaper Class="pa-3 mt-3 sv-card" Elevation="0">
                <MudText Typo="Typo.caption" Class="sv-text-muted">@_echoMeta</MudText>
                <pre class="mono" style="white-space:pre-wrap; color:#DDD;">@_echoOut</pre>
            </MudPaper>
        }
    </MudPaper>
</MudStack>

@code {
    private SafeView.LLM.LlmOptions _opts = new();
    private bool _busy;
    private bool? _pingResult;
    private string _echoOut = string.Empty;
    private string _echoMeta = string.Empty;

    protected override void OnInitialized() => _opts = LlmOpts.CurrentValue;

    private async Task PingAsync()
    {
        _busy = true; _pingResult = null;
        try { _pingResult = await Chat.PingAsync(); }
        catch { _pingResult = false; }
        finally { _busy = false; }
    }

    private async Task EchoAsync()
    {
        _busy = true; _echoOut = string.Empty;
        try
        {
            var resp = await Chat.ChatAsync([
                new(SafeView.Application.Abstractions.LLM.ChatRole.System, "Jesteś asystentem SafeView. Odpowiadaj zwięźle po polsku."),
                new(SafeView.Application.Abstractions.LLM.ChatRole.User, "Powiedz w jednym zdaniu, czy działasz poprawnie i jaki jesteś modelem.")
            ], new SafeView.Application.Abstractions.LLM.ChatOptions(Temperature: 0.2, MaxTokens: 200));
            if (resp.Success)
            {
                _echoOut = resp.Content;
                _echoMeta = $"model={resp.Model} · prompt={resp.PromptTokens} · completion={resp.CompletionTokens} · {resp.Latency.TotalMilliseconds:N0} ms";
                Snackbar.Add("OK", Severity.Success);
            }
            else
            {
                _echoOut = resp.ErrorMessage ?? "(błąd)";
                _echoMeta = "Error";
                Snackbar.Add("LLM error", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _echoOut = ex.Message;
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }
}
