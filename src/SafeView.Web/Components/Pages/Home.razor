    private async Task DownloadReport(TimeRangePresets.PresetKey preset, ReportStyle style = ReportStyle.Graphic)
    {
        var range = TimeRangePresets.Resolve(preset, DateTime.UtcNow);
        var qs = $"from={range.FromUtc:yyyy-MM-ddTHH:mm:ss}Z&to={range.ToUtc:yyyy-MM-ddTHH:mm:ss}Z&style={style}";
        var url = $"/reports/incidents.pdf?{qs}";
        var dlg = await Dialogs.ShowAsync<ReportGenerationDialog>(string.Empty,
            new DialogOptions
            {
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false,
                NoHeader = true,
                MaxWidth = MaxWidth.ExtraSmall,
            });
        try { await JS.InvokeAsync<object>("safeview.downloadFile", url, "safeview_report.pdf"); }
        finally { dlg.Close(); }
    }

    private static string DeltaArrow(double d) => d > 0 ? "▲" : (d < 0 ? "▼" : "■");
    private static string DeltaClass(double d) => d > 0 ? "sv-delta-up" : (d < 0 ? "sv-delta-down" : "sv-delta-flat");

    private static Color SeverityColor(IncidentSeverity s) => s switch
    {
        IncidentSeverity.Low      => Color.Info,
        IncidentSeverity.Medium   => Color.Warning,
        IncidentSeverity.High     => Color.Error,
        IncidentSeverity.Critical => Color.Error,
        _ => Color.Default
    };

    private static string CategoryColor(string category)
    {
        if (string.IsNullOrEmpty(category)) return "#7EB6FF";
        if (category.StartsWith("ppe.", StringComparison.OrdinalIgnoreCase))    return "#FFD600";
        if (category.StartsWith("hazard.", StringComparison.OrdinalIgnoreCase)) return "#FF5964";
        if (category.StartsWith("zone.", StringComparison.OrdinalIgnoreCase))   return "#7EB6FF";
        if (category.StartsWith("traffic.", StringComparison.OrdinalIgnoreCase))return "#A78BFA";
        return "#9CA3AF";
    }

    private static string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 60) return "teraz";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min";
        if (span.TotalHours < 24)   return $"{(int)span.TotalHours} h";
        if (span.TotalDays < 7)     return $"{(int)span.TotalDays} d";
        return utc.ToLocalTime().ToString("dd.MM");
    }

