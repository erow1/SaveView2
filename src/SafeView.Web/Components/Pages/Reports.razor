@page "/reports"
@attribute [Authorize(Policy = "perm:reports:view")]
@inject SafeView.Application.Abstractions.Persistence.ICameraRepository CameraRepo
@inject SafeView.Application.Abstractions.Persistence.IIncidentRepository IncidentRepo
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@rendermode InteractiveServer

<PageTitle>@L["Reports.Title"] — @L["AppName"]</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">@L["Reports.Title"]</MudText>

    <MudPaper Class="pa-4 sv-card" Elevation="0">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_from" Label="@L["Reports.From"]" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker @bind-Date="_to" Label="@L["Reports.To"]" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_cameraId" Label="@L["Reports.CameraOptional"]" Variant="Variant.Outlined" Clearable="true">
                    <MudSelectItem Value="@((string?)null)">@L["Reports.AllCameras"]</MudSelectItem>
                    @foreach (var c in _cameras)
                    {
                        <MudSelectItem Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="SafeView.Domain.Incidents.IncidentSeverity?" @bind-Value="_minSeverity"
                           Label="@L["Reports.MinSeverity"]" Variant="Variant.Outlined" Clearable="true">
                    <MudSelectItem Value="@((SafeView.Domain.Incidents.IncidentSeverity?)null)">— dowolna —</MudSelectItem>
                    @foreach (var s in Enum.GetValues<SafeView.Domain.Incidents.IncidentSeverity>())
                    {
                        <MudSelectItem Value="@((SafeView.Domain.Incidents.IncidentSeverity?)s)">@s</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <AuthorizeView Policy="perm:reports:generate" Context="_auth">
                <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Primary" Variant="Variant.Filled"
                           OnClick="@(() => Download("pdf"))">PDF</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.TableChart" Color="Color.Primary" Variant="Variant.Outlined"
                           OnClick="@(() => Download("csv"))">CSV</MudButton>
            </AuthorizeView>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadPreview" Variant="Variant.Outlined">@L["Reports.Preview"]</MudButton>
        </MudStack>
    </MudPaper>

    @if (_preview is not null)
    {
        <MudPaper Class="pa-4 sv-card" Elevation="0">
            <MudText Typo="Typo.h6">Podgląd</MudText>
            <MudGrid Class="mt-2">
                <MudItem xs="6" md="3"><Stat Label="Łącznie" Value="@_preview.Total.ToString()" /></MudItem>
                <MudItem xs="6" md="3"><Stat Label="Critical" Value="@_preview.Critical.ToString()" Color="#FF2D2D" /></MudItem>
                <MudItem xs="6" md="3"><Stat Label="High" Value="@_preview.High.ToString()" Color="#FF5964" /></MudItem>
                <MudItem xs="6" md="3"><Stat Label="Medium" Value="@_preview.Medium.ToString()" Color="#F5A524" /></MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudStack>

@code {
    private DateTime? _from = DateTime.UtcNow.Date.AddDays(-7);
    private DateTime? _to = DateTime.UtcNow.Date;
    private string? _cameraId;
    private SafeView.Domain.Incidents.IncidentSeverity? _minSeverity;
    private List<SafeView.Domain.Cameras.Camera> _cameras = new();
    private PreviewStats? _preview;

    protected override async Task OnInitializedAsync()
    {
        _cameras = (await CameraRepo.ListAsync()).OrderBy(c => c.Name, StringComparer.Ordinal).ToList();
    }

    private async Task LoadPreview()
    {
        var f = _from?.Date ?? DateTime.UtcNow.Date.AddDays(-7);
        var t = (_to?.Date ?? DateTime.UtcNow.Date).AddDays(1);
        var data = (await IncidentRepo.ListByDateRangeAsync(f, t)).AsEnumerable();
        if (!string.IsNullOrEmpty(_cameraId)) data = data.Where(i => i.CameraId == _cameraId);
        if (_minSeverity is not null) data = data.Where(i => i.Severity >= _minSeverity);
        var list = data.ToList();
        _preview = new PreviewStats(
            list.Count,
            list.Count(i => i.Severity == SafeView.Domain.Incidents.IncidentSeverity.Critical),
            list.Count(i => i.Severity == SafeView.Domain.Incidents.IncidentSeverity.High),
            list.Count(i => i.Severity == SafeView.Domain.Incidents.IncidentSeverity.Medium));
    }

    private void Download(string format)
    {
        var f = _from?.Date ?? DateTime.UtcNow.Date.AddDays(-7);
        var t = (_to?.Date ?? DateTime.UtcNow.Date).AddDays(1);
        var qs = new List<string>
        {
            $"from={f:yyyy-MM-dd}",
            $"to={t:yyyy-MM-dd}"
        };
        if (!string.IsNullOrEmpty(_cameraId)) qs.Add($"cameraId={Uri.EscapeDataString(_cameraId)}");
        if (_minSeverity is not null) qs.Add($"minSeverity={_minSeverity}");
        Nav.NavigateTo($"/reports/incidents.{format}?{string.Join("&", qs)}", forceLoad: true);
    }

    private sealed record PreviewStats(int Total, int Critical, int High, int Medium);
}
