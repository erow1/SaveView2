@page "/reports"
@attribute [Authorize(Policy = "perm:reports:view")]
@inject NavigationManager Nav

@code {
    // Strona Raporty została zmergowana z /incidents (filtry + lista + generowanie raportu
    // dzielą te same parametry — utrzymywanie ich osobno mnożyło duplikację UX).
    // Zachowujemy /reports jako trwały redirect dla zewnętrznych linków / bookmarków.
    protected override void OnInitialized() => Nav.NavigateTo("/incidents", replace: true);
}
