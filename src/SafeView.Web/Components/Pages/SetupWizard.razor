    // ── Logic ─────────────────────────────────────────────────────────

    /// <summary>
    /// Toggle wyboru klasy. Przy pierwszym wyborze tworzymy roboczy <see cref="Trigger"/> z
    /// sensownymi defaultami (1 warunek dla tej klasy, MinCount=1, MinConfidence z klasy,
    /// CenterInZone). Drugi click usuwa klasę razem z jej draftem (zmiany użytkownika tracone
    /// — to celowe, bo wybranie ponownie to "świeży start").
    /// </summary>
    private void TogglePickClass(string classId)
    {
        if (_triggerByClassId.ContainsKey(classId))
        {
            _triggerByClassId.Remove(classId);
            return;
        }
        var klass = _availableClasses.FirstOrDefault(c => c.Id == classId);
        if (klass is null) return;
        _triggerByClassId[classId] = new Trigger
        {
            Name = klass.Name, // camera prefix doklejany w FinishAsync
            Enabled = true,
            Conditions =
            [
                new TriggerCondition
                {
                    DetectionClassId = classId,
                    MinCount = 1,
                    MinConfidence = klass.RecommendedMinConfidence,
                    BboxRule = BboxRule.CenterInZone
                }
            ]
            // ActionIds — celowo puste; FinishAsync przyklei utworzoną akcję
        };
    }

    /// <summary>
    /// Otwiera <c>TriggerEditDialog</c> dla draftu klasy. ActionIds = lista pusta — akcja jeszcze
    /// nie istnieje (kreator tworzy ją w step 5). Trigger jest mutowany in-place przez sub-kreator
    /// — anulowanie sub-kreatora NIE cofa zmian (akceptowalne kompromis dla MVP, user może
    /// odznaczyć klasę i wybrać ponownie żeby dostać świeży draft).
    /// </summary>
    private async Task OpenTriggerSubWizard(string classId)
    {
        if (!_triggerByClassId.TryGetValue(classId, out var trigger)) return;
        var parameters = new DialogParameters
        {
            ["Trigger"] = trigger,
            ["IsNew"] = true,
            ["Models"] = _availableModels,
            ["Actions"] = new List<DetectionAction>(), // akcja powstanie w step 5
            ["Templates"] = _availableTemplates,
            ["DetectionClasses"] = _availableClasses,
            ["LlmProviders"] = _availableLlmProviders,
            ["CompatibleModelIds"] = new HashSet<string>()
        };
        var dlg = await Dialog.ShowAsync<TriggerEditDialog>(
            L["Wizard.Step2.EditTriggerTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        await dlg.Result;
        StateHasChanged();
    }

    /// <summary>Krótkie chipy stanu triggera — pokazują niedefaultowe ustawienia bez rozwijania.</summary>
    private IEnumerable<string> TriggerStatusChips(Trigger t)
    {
        if (t.Conditions.FirstOrDefault()?.MinConfidence is { } mc)
            yield return $"≥{mc * 100:F0}%";
        if (t.Schedule is { } s)
            yield return $"{s.StartMinute / 60:D2}-{s.EndMinute / 60:D2}";
        if (t.CooldownSeconds > 0)
            yield return $"cd {t.CooldownSeconds}s";
        if (t.PersistentFrames > 1)
            yield return $"{t.PersistentFrames}f";
        if (t.VllmCheck is { Enabled: true } v)
            yield return v.TemplateId is not null
                ? $"AI: {_availableTemplates.FirstOrDefault(x => x.Id == v.TemplateId)?.Name ?? "ON"}"
                : "AI";
        if (t.Conditions.Any(c => c.Containment is not null))
            yield return L["Wizard.Step2.ChipContainment"];
        if (t.Conditions.Any(c => c.Motion is not null))
            yield return L["Wizard.Step2.ChipMotion"];
        if (t.SpatialFilters.Count > 0)
            yield return $"spatial ×{t.SpatialFilters.Count}";
    }

    private bool CanAdvance() => _step switch
    {
        1 => !string.IsNullOrEmpty(_selectedCameraId),
        2 => _roiMode == RoiMode.FullFrame
             ? !string.IsNullOrWhiteSpace(_newRoiName)
             : !string.IsNullOrEmpty(_selectedRoiId),
        3 => _zoneMode == ZoneMode.FullRoi
             ? !string.IsNullOrWhiteSpace(_newZoneName)
             : !string.IsNullOrEmpty(_selectedZoneId),
        4 => _triggerByClassId.Count > 0,
        5 => !string.IsNullOrWhiteSpace(_actionName)
             && (_actionType != ActionType.Email || !string.IsNullOrWhiteSpace(_emailTo))
             && (_actionType != ActionType.Webhook || !string.IsNullOrWhiteSpace(_webhookUrl)),
        _ => true
    };

    private async Task NextStep()
    {
        if (!CanAdvance() || _step >= 6) return;
        _step++;
        // Po wyjściu z kroku 1 (Kamera) ładujemy ROI + strefy dla wybranej kamery,
        // żeby Step 2 (ROI) i Step 3 (Strefa) pokazały listy do wyboru.
        if (_step == 2) await ReloadScopeForCameraAsync();
    }

    private void GoHome() => Nav.NavigateTo("/");

    /// <summary>Otwiera dialog edycji ROI inline z pre-filled kamerą — bez opuszczania wizarda.
    /// Po zapisie ROI trafia do DB, dodaje się do listy i auto-selectujemy w trybie Existing.</summary>
    private async Task OpenNewRoiDialog()
    {
        if (string.IsNullOrEmpty(_selectedCameraId)) return;
        var roi = new Roi
        {
            CameraId = _selectedCameraId,
            Rectangle = new RoiRectangle { X = 0.1, Y = 0.1, Width = 0.8, Height = 0.8 }
        };
        var parameters = new DialogParameters
        {
            ["Roi"] = roi,
            ["IsNew"] = true,
            ["Cameras"] = _availableCameras,
            ["Models"] = _availableModels
        };
        var dlg = await Dialog.ShowAsync<RoiDialog>(
            L["Wizard.StepRoi.CreateDialogTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: Roi saved })
        {
            try
            {
                await RoiRepo.InsertAsync(saved);
                _roisForCamera.Add(saved);
                _roiMode = RoiMode.Existing;
                _selectedRoiId = saved.Id;
                _selectedZoneId = null;
                _zoneMode = ZoneMode.FullRoi;
                Snackbar.Add(L["Wizard.StepRoi.Created"], Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"Błąd: {ex.Message}", Severity.Error); }
        }
    }

    /// <summary>Otwiera dialog edycji strefy inline z pre-filled ROI z kontekstu.
    /// Wymaga że user już ma wybrany konkretny ROI (nie tryb FullFrame).</summary>
    private async Task OpenNewZoneDialog()
    {
        if (_roiMode != RoiMode.Existing || string.IsNullOrEmpty(_selectedRoiId))
        {
            Snackbar.Add(L["Wizard.StepZone.SelectRoiFirst"], Severity.Warning);
            return;
        }
        var selectedRoi = _roisForCamera.First(r => r.Id == _selectedRoiId);
        var zone = new Zone
        {
            CameraId = _selectedCameraId!,
            RoiId = _selectedRoiId,
            // Domyślny polygon = środkowe 60% ROI żeby user zobaczył gdzie rysuje, nie cały ROI
            Polygon = BuildDefaultPolygon(selectedRoi.Rectangle)
        };
        var parameters = new DialogParameters
        {
            ["Zone"] = zone,
            ["IsNew"] = true,
            ["Cameras"] = _availableCameras,
            ["Rois"] = _roisForCamera,
            ["AvailableTriggers"] = new List<Trigger>() // wizard sam tworzy triggery w FinishAsync
        };
        var dlg = await Dialog.ShowAsync<ZoneEditorDialog>(
            L["Wizard.StepZone.CreateDialogTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: Zone saved })
        {
            try
            {
                await ZoneRepo.InsertAsync(saved);
                _zonesForCamera.Add(saved);
                _zoneMode = ZoneMode.Existing;
                _selectedZoneId = saved.Id;
                Snackbar.Add(L["Wizard.StepZone.Created"], Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"Błąd: {ex.Message}", Severity.Error); }
        }
    }

    private static List<SafeView.Domain.Zones.ZonePoint> BuildDefaultPolygon(RoiRectangle r)
    {
        // 60% środka prostokąta ROI — user widzi że trzeba coś zmienić żeby dopasować.
        var x0 = r.X + r.Width * 0.2;
        var y0 = r.Y + r.Height * 0.2;
        var x1 = r.X + r.Width * 0.8;
        var y1 = r.Y + r.Height * 0.8;
        return
        [
            new() { X = x0, Y = y0 },
            new() { X = x1, Y = y0 },
            new() { X = x1, Y = y1 },
            new() { X = x0, Y = y1 }
        ];
    }

    /// <summary>Otwiera istniejący DetectionClassDialog w trybie tworzenia. Po zapisie nowa klasa
    /// trafia do bazy — reloadujemy listę i auto-zaznaczamy nowo dodaną żeby user nie musiał klikać.</summary>
    private async Task OpenNewClassDialog()
    {
        var newClass = new DetectionClass
        {
            Name = "",
            Category = "Custom",
            Kind = DetectionClassKind.Text,
            RecommendedMinConfidence = 0.30
        };
        var parameters = new DialogParameters
        {
            ["Class"] = newClass,
            ["IsNew"] = true,
            ["Models"] = _availableModels
        };
        var dlg = await Dialog.ShowAsync<DetectionClassDialog>(
            L["Wizard.Step2.NewClassTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: DetectionClass saved })
        {
            try
            {
                await ClassRepo.InsertAsync(saved);
                await ReloadClassesAsync();
                TogglePickClass(saved.Id); // auto-pick z draftem triggera
                Snackbar.Add(L["Wizard.Step2.ClassAdded"], Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"Błąd: {ex.Message}", Severity.Error); }
        }
    }

    private async Task FinishAsync()
    {
        _creating = true;
        try
        {
            // 1. Użyj wybranej kamery (technik dodał ją wcześniej w /cameras)
            var camera = _availableCameras.First(c => c.Id == _selectedCameraId);

            // 2. ROI — nowy (cały kadr) albo istniejący
            Roi roi;
            if (_roiMode == RoiMode.FullFrame)
            {
                roi = new Roi
                {
                    Name = _newRoiName,
                    CameraId = camera.Id,
                    Rectangle = new RoiRectangle { X = 0, Y = 0, Width = 1, Height = 1 },
                    Enabled = true
                };
                await RoiRepo.InsertAsync(roi);
            }
            else
            {
                roi = _roisForCamera.First(r => r.Id == _selectedRoiId);
            }

            // 3. Strefa — nowa (polygon = prostokąt ROI) albo istniejąca w ROI
            Zone zone;
            if (_zoneMode == ZoneMode.FullRoi)
            {
                var r = roi.Rectangle;
                zone = new Zone
                {
                    Name = _newZoneName,
                    CameraId = camera.Id,
                    RoiId = roi.Id,
                    Polygon =
                    [
                        new() { X = r.X,           Y = r.Y },
                        new() { X = r.X + r.Width, Y = r.Y },
                        new() { X = r.X + r.Width, Y = r.Y + r.Height },
                        new() { X = r.X,           Y = r.Y + r.Height }
                    ],
                    Enabled = true
                };
                await ZoneRepo.InsertAsync(zone);
            }
            else
            {
                zone = _zonesForCamera.First(z => z.Id == _selectedZoneId);
            }

            // 4. Akcja
            var action = new DetectionAction
            {
                Name = _actionName,
                Type = _actionType,
                Enabled = true,
                Config = BuildActionConfig()
            };
            await ActionRepo.InsertAsync(action);

            // 5. Triggery — z drafty per klasa zbudowane w step 4 (sub-kreator) lub defaulty.
            // Do każdego draftu doklejamy prefix kamery do nazwy + akcję utworzoną w step 5.
            var triggerIds = new List<string>();
            foreach (var (classId, trigger) in _triggerByClassId)
            {
                var klass = _availableClasses.FirstOrDefault(c => c.Id == classId);
                if (klass is null) continue;
                if (string.IsNullOrEmpty(trigger.Name) || trigger.Name == klass.Name)
                    trigger.Name = $"{camera.Name} — {klass.Name}";
                if (!trigger.ActionIds.Contains(action.Id))
                    trigger.ActionIds.Add(action.Id);
                await TriggerRepo.InsertAsync(trigger);
                triggerIds.Add(trigger.Id);
            }

            // 6. Spinamy zone → trigger IDs
            // Spinamy nowe triggery z istniejącymi (append, nie nadpisujemy — zone mogła już mieć inne)
            foreach (var tid in triggerIds)
                if (!zone.TriggerIds.Contains(tid)) zone.TriggerIds.Add(tid);
            await ZoneRepo.UpdateAsync(zone);

            Snackbar.Add(string.Format(L["Wizard.Done"], camera.Name, triggerIds.Count), Severity.Success);
            Nav.NavigateTo("/flow");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            _creating = false;
        }
    }

    private Dictionary<string, string> BuildActionConfig() => _actionType switch
    {
        ActionType.Email => new() { ["to"] = _emailTo, ["subject"] = "[SafeView] {trigger_name} — {camera_name}" },
        ActionType.Webhook => new() { ["url"] = _webhookUrl, ["method"] = "POST" },
        _ => new()
    };

