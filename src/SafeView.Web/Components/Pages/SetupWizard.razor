@page "/setup-wizard"
@attribute [Authorize(Policy = "perm:admin:triggers")]
@using SafeView.Domain.Cameras
@using SafeView.Domain.Detection
@using SafeView.Domain.Zones
@inject SafeView.Application.Abstractions.Persistence.ICameraRepository CameraRepo
@inject SafeView.Application.Abstractions.Persistence.IRoiRepository RoiRepo
@inject SafeView.Application.Abstractions.Persistence.IZoneRepository ZoneRepo
@inject SafeView.Application.Abstractions.Persistence.IDetectionClassRepository ClassRepo
@inject SafeView.Application.Abstractions.Persistence.ITriggerRepository TriggerRepo
@inject SafeView.Application.Abstractions.Persistence.IActionRepository ActionRepo
@inject SafeView.Application.Abstractions.Persistence.IMLModelRepository ModelRepo
@inject SafeView.Application.Abstractions.Persistence.IPromptTemplateRepository TemplateRepo
@inject SafeView.Application.Abstractions.Persistence.ILlmProviderRepository LlmProviderRepo
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@rendermode InteractiveServer

<PageTitle>@L["Wizard.Title"] — @L["AppName"]</PageTitle>

<MudStack Spacing="3" Style="max-width:1200px; margin:0 auto;">
    @* ── Header + progress ──────────────────────────────────────────── *@
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Large" Style="color:var(--mud-palette-primary);" />
        <div>
            <MudText Typo="Typo.h4">@L["Wizard.Title"]</MudText>
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                @L["Wizard.Subtitle"]
            </MudText>
        </div>
        <MudSpacer />
        @if (_step > 1)
        {
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="() => _step--" Variant="Variant.Outlined">
                @L["Wizard.Back"]
            </MudButton>
        }
        @if (_step < 6)
        {
            <MudButton EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="NextStep" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="@(!CanAdvance())">
                @L["Wizard.Next"]
            </MudButton>
        }
        else
        {
            <MudButton StartIcon="@Icons.Material.Filled.CheckCircle"
                       OnClick="FinishAsync" Color="Color.Success" Variant="Variant.Filled"
                       Disabled="@_creating">
                @L["Wizard.CreateAndRun"]
            </MudButton>
        }
    </MudStack>

    <MudPaper Class="pa-3 sv-card" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @for (int i = 1; i <= 6; i++)
            {
                var stepIdx = i;
                var state = stepIdx < _step ? "done" : stepIdx == _step ? "active" : "pending";
                <div style="@($"display:flex; align-items:center; gap:6px; padding:4px 10px; border-radius:18px; {StepPillStyle(state)}")">
                    @if (state == "done")
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    }
                    else
                    {
                        <span class="mono" style="font-weight:700;">@stepIdx</span>
                    }
                    <span>@StepLabel(stepIdx)</span>
                </div>
                @if (i < 6)
                {
                    <div style="flex:1; height:2px; background:var(--mud-palette-lines-default);"></div>
                }
            }
        </MudStack>
    </MudPaper>

    @* ── Content per step + help sidebar ───────────────────────────── *@
    <div style="display:grid; grid-template-columns: 2fr 1fr; gap:16px;">
        <MudPaper Class="pa-4 sv-card" Elevation="0">
            @switch (_step)
            {
                case 1: @StepCamera(); break;
                case 2: @StepRoi(); break;         @* ROI — prostokątny obszar analizy ML *@
                case 3: @StepZone(); break;        @* Strefa — polygon w ROI gdzie trigger wypala *@
                case 4: @StepClasses(); break;
                case 5: @StepAction(); break;
                case 6: @StepSummary(); break;
            }
        </MudPaper>

        <MudPaper Class="pa-3 sv-card" Elevation="0" Style="align-self:flex-start; position:sticky; top:16px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Style="color:var(--mud-palette-primary);" />
                <MudText Typo="Typo.subtitle2">@L["Wizard.Help"]</MudText>
            </MudStack>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.body2" Style="white-space:pre-line;">@HelpText()</MudText>
        </MudPaper>
    </div>

    @* ── Footer (tylko Cancel; Back/Next/Finish na górze) ──────────── *@
    <MudStack Row="true" Spacing="2">
        <MudButton OnClick="GoHome" Variant="Variant.Text">
            @L["Common.Cancel"]
        </MudButton>
    </MudStack>
</MudStack>

@code {
    // ── State ──────────────────────────────────────────────────────────
    private int _step = 1;
    private bool _creating;

    // Step 1 — Wybór istniejącej kamery (technik dodaje je w /cameras; user tylko wybiera)
    private List<Camera> _availableCameras = new();
    private string? _selectedCameraId;

    // Step 2 — ROI (Region Of Interest — prostokąt który analizuje model ML)
    private enum RoiMode { FullFrame, Existing }
    private RoiMode _roiMode = RoiMode.FullFrame;
    private string? _selectedRoiId;
    private string _newRoiName = "Cały kadr";
    private List<Roi> _roisForCamera = new();

    // Step 3 — Zone (strefa alertu — polygon wewnątrz ROI)
    private enum ZoneMode { FullRoi, Existing }
    private ZoneMode _zoneMode = ZoneMode.FullRoi;
    private string? _selectedZoneId;
    private string _newZoneName = "Cała strefa";
    private List<Zone> _zonesForCamera = new();

    // Step 4 — Classes + per-class trigger drafts
    // Każda wybrana klasa ma swój roboczy obiekt Trigger (mutowany przez sub-kreator
    // TriggerEditDialog). Defaulty ustawione przy pierwszym wybraniu klasy. ActionIds
    // pozostawiamy puste — akcję dorzucamy w FinishAsync (utworzona dopiero w step 5).
    private List<DetectionClass> _availableClasses = new();
    private List<SafeView.Domain.ML.MLModel> _availableModels = new();
    private List<SafeView.Domain.Vllm.PromptTemplate> _availableTemplates = new();
    private List<SafeView.Domain.Llm.LlmProvider> _availableLlmProviders = new();
    private Dictionary<string, Trigger> _triggerByClassId = new(StringComparer.Ordinal);

    // Step 4 — Action
    private ActionType _actionType = ActionType.InAppNotification;
    private string _actionName = "Alert BHP";
    private string _emailTo = string.Empty;
    private string _webhookUrl = string.Empty;

    /// <summary>
    /// Otwiera <c>RoiDialog</c> w trybie edycji wskazanego ROI. Po zamknięciu wracamy do tego
    /// samego kroku wizarda (komponent zostaje zamontowany — dialog jest tylko overlay-em).
    /// Używane przez ołówek na kafelku, propagacja kliknięcia jest blokowana wyżej.
    /// </summary>
    private async Task OpenEditRoiAsync(Roi roi)
    {
        var parameters = new DialogParameters
        {
            ["Roi"] = roi,
            ["IsNew"] = false,
            ["Cameras"] = _availableCameras,
            ["Models"] = _availableModels
        };
        var dlg = await Dialog.ShowAsync<RoiDialog>(
            L["Rois.EditTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: Roi saved })
        {
            try
            {
                await RoiRepo.UpdateAsync(saved);
                // Podmień instancję w lokalnej liście — żeby kafelek pokazywał świeże dane
                // bez ponownego query do Mongo.
                var idx = _roisForCamera.FindIndex(r => r.Id == saved.Id);
                if (idx >= 0) _roisForCamera[idx] = saved;
                Snackbar.Add(L["Rois.Saved"], Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"Błąd: {ex.Message}", Severity.Error); }
        }
    }

    /// <summary>Analog dla strefy. Wracamy do step 3 wizarda po zamknięciu dialogu.</summary>
    private async Task OpenEditZoneAsync(Zone zone)
    {
        var parameters = new DialogParameters
        {
            ["Zone"] = zone,
            ["IsNew"] = false,
            ["Cameras"] = _availableCameras,
            ["Rois"] = _roisForCamera,
            ["AvailableTriggers"] = new List<Trigger>()
        };
        var dlg = await Dialog.ShowAsync<ZoneEditorDialog>(
            L["ZoneDialog.EditTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: Zone saved })
        {
            try
            {
                await ZoneRepo.UpdateAsync(saved);
                var idx = _zonesForCamera.FindIndex(z => z.Id == saved.Id);
                if (idx >= 0) _zonesForCamera[idx] = saved;
                Snackbar.Add(L["Zones.Saved"], Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"Błąd: {ex.Message}", Severity.Error); }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _availableCameras = (await CameraRepo.ListAsync())
            .Where(c => c.Enabled)
            .OrderBy(c => c.Name, StringComparer.Ordinal)
            .ToList();
        _availableModels = (await ModelRepo.ListAsync()).ToList();
        _availableTemplates = (await TemplateRepo.ListAsync()).ToList();
        _availableLlmProviders = (await LlmProviderRepo.ListAsync()).ToList();
        await ReloadClassesAsync();
    }

    private async Task ReloadClassesAsync()
    {
        _availableClasses = (await ClassRepo.ListAsync())
            .OrderBy(c => c.Category, StringComparer.Ordinal)
            .ThenBy(c => c.Name, StringComparer.Ordinal)
            .ToList();
    }

    /// <summary>Ładuje ROI + strefy dla wybranej kamery — wywoływane po przejściu z Step1.</summary>
    private async Task ReloadScopeForCameraAsync()
    {
        if (string.IsNullOrEmpty(_selectedCameraId)) return;
        _roisForCamera = (await RoiRepo.ListByCameraAsync(_selectedCameraId)).ToList();
        _zonesForCamera = (await ZoneRepo.ListByCameraAsync(_selectedCameraId)).ToList();
        // Gdy są istniejące ROI, preselectuj tryb "istniejący" — operator prawdopodobnie
        // chce użyć tego co technik już skonfigurował.
        if (_roisForCamera.Count > 0 && _roiMode == RoiMode.FullFrame && string.IsNullOrEmpty(_selectedRoiId))
        {
            _roiMode = RoiMode.Existing;
            _selectedRoiId = _roisForCamera[0].Id;
        }
    }

    /// <summary>Strefy które leżą w aktualnie wybranym ROI (używane w Step 3).</summary>
    private List<Zone> ZonesForSelectedRoi()
    {
        if (_roiMode != RoiMode.Existing || string.IsNullOrEmpty(_selectedRoiId)) return new();
        return _zonesForCamera.Where(z => z.RoiId == _selectedRoiId).ToList();
    }

    // ── Step content renderers ─────────────────────────────────────────

    private RenderFragment StepCamera() => @<MudStack Spacing="3">
        <MudText Typo="Typo.h6">@L["Wizard.Step1.Title"]</MudText>
        <MudText Typo="Typo.caption" Class="sv-text-muted">@L["Wizard.Step1.Subtitle"]</MudText>

        @if (_availableCameras.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VideocamOff">
                <MudText Typo="Typo.body2"><strong>@L["Wizard.Step1.NoCameras"]</strong></MudText>
                <MudText Typo="Typo.caption">@L["Wizard.Step1.NoCamerasHint"]</MudText>
            </MudAlert>
            <MudButton Href="/cameras" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.OpenInNew">
                @L["Wizard.Step1.GoToCameras"]
            </MudButton>
        }
        else
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:12px;">
                @foreach (var cam in _availableCameras)
                {
                    var picked = _selectedCameraId == cam.Id;
                    <MudPaper Elevation="0"
                              Style="@($"cursor:pointer; border:2px solid {(picked ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)")}; border-radius:6px; overflow:hidden;")"
                              @onclick="@(() => _selectedCameraId = cam.Id)">
                        @* Miniaturka — snapshot z kamery, placeholder gdy brak / offline *@
                        <div style="position:relative; width:100%; aspect-ratio:16/9; background:#1a1a1a; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                            <MudStack AlignItems="AlignItems.Center" Spacing="0">
                                <MudIcon Icon="@Icons.Material.Filled.VideocamOff" Size="Size.Large"
                                         Style="color:#555;" />
                                <MudText Typo="Typo.caption" Style="color:#777;">@L["Wizard.Step1.Offline"]</MudText>
                            </MudStack>
                            <img src="@($"/cameras/{cam.Id}/snapshot.jpg")" alt="@cam.Name"
                                 style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;"
                                 onerror="this.remove();" />
                            @if (picked)
                            {
                                <div style="position:absolute; top:8px; right:8px; background:var(--mud-palette-primary); color:var(--mud-palette-primary-text); border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center;">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                </div>
                            }
                        </div>
                        <div style="padding:10px 12px;">
                            <MudText Typo="Typo.body1" Style="@(picked ? "font-weight:600;" : "")">@cam.Name</MudText>
                            @if (!string.IsNullOrEmpty(cam.Location))
                            {
                                <MudText Typo="Typo.caption" Class="sv-text-muted">@cam.Location</MudText>
                            }
                            <MudText Typo="Typo.caption" Class="sv-text-muted mono"
                                     Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:block;">
                                @cam.Vendor · @cam.Transport
                            </MudText>
                        </div>
                    </MudPaper>
                }
            </div>
            <MudText Typo="Typo.caption" Class="sv-text-muted">
                @string.Format(L["Wizard.Step1.AvailableCount"], _availableCameras.Count)
            </MudText>
        }
    </MudStack>;

    private RenderFragment StepClasses() => @<MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <div style="flex:1;">
                <MudText Typo="Typo.h6">@L["Wizard.Step2.Title"]</MudText>
                <MudText Typo="Typo.caption" Class="sv-text-muted">@L["Wizard.Step2.Subtitle"]</MudText>
            </div>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined"
                       Color="Color.Primary" OnClick="OpenNewClassDialog">
                @L["Wizard.Step2.NewClass"]
            </MudButton>
        </MudStack>

        @if (_availableClasses.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Warning">
                @L["Wizard.Step2.NoClasses"]
            </MudAlert>
        }
        else
        {
            @foreach (var grp in _availableClasses.GroupBy(c => c.Category).OrderBy(g => g.Key, StringComparer.Ordinal))
            {
                <MudText Typo="Typo.overline" Class="mono sv-text-muted">@grp.Key</MudText>
                <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:8px;">
                    @foreach (var c in grp.OrderBy(x => x.Name, StringComparer.Ordinal))
                    {
                        var picked = _triggerByClassId.ContainsKey(c.Id);
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="@($"cursor:pointer; border:2px solid {(picked ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)")}; border-radius:6px;")"
                                  @onclick="@(() => TogglePickClass(c.Id))">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                <MudIcon Icon="@IconForCategory(c.Category)" Size="Size.Medium"
                                         Style="@($"color:{(picked ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)")};")" />
                                <div style="flex:1;">
                                    <MudText Typo="Typo.body1" Style="@(picked ? "font-weight:600;" : "")">@c.Name</MudText>
                                    @if (!string.IsNullOrEmpty(c.Description))
                                    {
                                        <MudText Typo="Typo.caption" Class="sv-text-muted" Style="white-space:normal;">
                                            @c.Description
                                        </MudText>
                                    }
                                </div>
                                @if (picked)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                             Style="color:var(--mud-palette-primary);" />
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </div>
            }
            <MudText Typo="Typo.caption" Class="sv-text-muted">
                @string.Format(L["Wizard.Step2.Selected"], _triggerByClassId.Count)
            </MudText>

            @* ── Per-class trigger preview cards z ołówkiem otwierającym sub-kreator ────── *@
            @if (_triggerByClassId.Count > 0)
            {
                <MudDivider />
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <div style="flex:1;">
                        <MudText Typo="Typo.subtitle1">@L["Wizard.Step2.RefineTriggers"]</MudText>
                        <MudText Typo="Typo.caption" Class="sv-text-muted">
                            @L["Wizard.Step2.RefineTriggersHint"]
                        </MudText>
                    </div>
                </MudStack>
                <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(360px,1fr)); gap:12px;">
                    @foreach (var (classId, trigger) in _triggerByClassId)
                    {
                        var klass = _availableClasses.FirstOrDefault(k => k.Id == classId);
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="border:1px solid var(--mud-palette-lines-default); border-radius:6px;">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small"
                                             Style="color:var(--mud-palette-primary);" />
                                    <MudText Typo="Typo.subtitle2">@(klass?.Name ?? classId)</MudText>
                                    <MudSpacer />
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               OnClick="@(() => OpenTriggerSubWizard(classId))">
                                        @L["Common.Edit"]
                                    </MudButton>
                                </MudStack>
                                <div style="display:flex; flex-wrap:wrap; gap:4px;">
                                    @foreach (var chip in TriggerStatusChips(trigger))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @chip
                                        </MudChip>
                                    }
                                </div>
                            </MudStack>
                        </MudPaper>
                    }
                </div>
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Info">
                    @L["Wizard.Step2.ActionWillBeAttached"]
                </MudAlert>
            }
        }
    </MudStack>;

    // ── Step 2: ROI ────────────────────────────────────────────────────
    private RenderFragment StepRoi() => @<MudStack Spacing="3">
        <MudText Typo="Typo.h6">@L["Wizard.StepRoi.Title"]</MudText>
        <MudText Typo="Typo.caption" Class="sv-text-muted">@L["Wizard.StepRoi.Subtitle"]</MudText>

        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:12px;">
            @* Karta: cały kadr (nowy ROI 0..1 × 0..1) *@
            @{
                var fullPicked = _roiMode == RoiMode.FullFrame;
            }
            <MudPaper Elevation="0"
                      Style="@($"cursor:pointer; border:2px solid {(fullPicked ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)")}; border-radius:6px; padding:14px;")"
                      @onclick="@(() => { _roiMode = RoiMode.FullFrame; _selectedRoiId = null; })">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.CropFree" Size="Size.Large"
                             Style="@($"color:{(fullPicked ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)")};")" />
                    <div style="flex:1;">
                        <MudText Typo="Typo.body1" Style="@(fullPicked ? "font-weight:600;" : "")">
                            @L["Wizard.StepRoi.FullFrame"]
                        </MudText>
                        <MudText Typo="Typo.caption" Class="sv-text-muted">
                            @L["Wizard.StepRoi.FullFrameHint"]
                        </MudText>
                    </div>
                    @if (fullPicked)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                 Style="color:var(--mud-palette-primary);" />
                    }
                </MudStack>
            </MudPaper>

            @* Karty: istniejące ROI dla tej kamery *@
            @foreach (var roi in _roisForCamera)
            {
                var roiPicked = _roiMode == RoiMode.Existing && _selectedRoiId == roi.Id;
                var zoneCount = _zonesForCamera.Count(z => z.RoiId == roi.Id);
                <MudPaper Elevation="0"
                          Style="@($"cursor:pointer; border:2px solid {(roiPicked ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)")}; border-radius:6px; padding:14px;")"
                          @onclick="@(() => { _roiMode = RoiMode.Existing; _selectedRoiId = roi.Id; _selectedZoneId = null; _zoneMode = ZoneMode.FullRoi; })">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.SelectAll" Size="Size.Large"
                                 Style="@($"color:{(roiPicked ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)")};")" />
                        <div style="flex:1;">
                            <MudText Typo="Typo.body1" Style="@(roiPicked ? "font-weight:600;" : "")">
                                @roi.Name
                            </MudText>
                            <MudText Typo="Typo.caption" Class="sv-text-muted mono">
                                @($"{roi.Rectangle.Width * 100:F0}% × {roi.Rectangle.Height * 100:F0}% kadru")
                                @if (!roi.Enabled) { <text> · off</text> }
                            </MudText>
                            <MudText Typo="Typo.caption" Class="sv-text-muted">
                                @string.Format(L["Wizard.StepRoi.ZonesInRoi"], zoneCount)
                            </MudText>
                        </div>
                        <div @onclick:stopPropagation="true" style="display:flex; gap:4px; align-items:center;">
                            <MudTooltip Text="@L["Common.Edit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditRoiAsync(roi))" />
                            </MudTooltip>
                            @if (roiPicked)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                         Style="color:var(--mud-palette-primary);" />
                            }
                        </div>
                    </MudStack>
                </MudPaper>
            }

            @* Karta: utwórz nowy ROI (inline dialog z pre-filled kamerą) *@
            <MudPaper Elevation="0"
                      Style="cursor:pointer; border:2px dashed var(--mud-palette-lines-default); border-radius:6px; padding:14px;"
                      @onclick="OpenNewRoiDialog">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large"
                             Style="color:var(--mud-palette-text-secondary);" />
                    <div style="flex:1;">
                        <MudText Typo="Typo.body1">@L["Wizard.StepRoi.CreateNew"]</MudText>
