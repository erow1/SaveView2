    // ── Step 3: Strefa w wybranym ROI ──────────────────────────────────
    private RenderFragment StepZone() => @<MudStack Spacing="3">
        <MudText Typo="Typo.h6">@L["Wizard.StepZone.Title"]</MudText>
        <MudText Typo="Typo.caption" Class="sv-text-muted">@L["Wizard.StepZone.Subtitle"]</MudText>

