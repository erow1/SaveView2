                    </MudStack>
                </MudPaper>
            }

            @* Karta: utwórz nową strefę (inline dialog z pre-filled ROI) *@
            <MudPaper Elevation="0"
                      Style="cursor:pointer; border:2px dashed var(--mud-palette-lines-default); border-radius:6px; padding:14px;"
                      @onclick="OpenNewZoneDialog">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large"
                             Style="color:var(--mud-palette-text-secondary);" />
                    <div style="flex:1;">
                        <MudText Typo="Typo.body1">@L["Wizard.StepZone.CreateNew"]</MudText>
                        <MudText Typo="Typo.caption" Class="sv-text-muted">@L["Wizard.StepZone.CreateNewHint"]</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                             Style="color:var(--mud-palette-text-secondary);" />
                </MudStack>
            </MudPaper>
        </div>

        @if (_zoneMode == ZoneMode.FullRoi)
        {
            <MudTextField @bind-Value="_newZoneName" Label="@L["Wizard.StepZone.Name"]"
                          HelperText="@L["Wizard.StepZone.NameHint"]"
                          Variant="Variant.Outlined" />
        }
    </MudStack>;

