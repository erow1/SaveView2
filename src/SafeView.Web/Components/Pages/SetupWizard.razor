            var roiContext = _roiMode == RoiMode.Existing
                ? _roisForCamera.FirstOrDefault(r => r.Id == _selectedRoiId)?.Name
                : _newRoiName;
            var zonesInRoi = ZonesForSelectedRoi();
        }
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.SelectAll" Dense="true">
            @string.Format(L["Wizard.StepZone.Context"], roiContext ?? "?")
        </MudAlert>

        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:12px;">
            @* Karta: cały ROI (nowa strefa = polygon obejmujący cały prostokąt ROI) *@
            @{
                var fullRoiPicked = _zoneMode == ZoneMode.FullRoi;
            }
            <MudPaper Elevation="0"
                      Style="@($"cursor:pointer; border:2px solid {(fullRoiPicked ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)")}; border-radius:6px; padding:14px;")"
                      @onclick="@(() => { _zoneMode = ZoneMode.FullRoi; _selectedZoneId = null; })">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.CropSquare" Size="Size.Large"
                             Style="@($"color:{(fullRoiPicked ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)")};")" />
                    <div style="flex:1;">
                        <MudText Typo="Typo.body1" Style="@(fullRoiPicked ? "font-weight:600;" : "")">
                            @L["Wizard.StepZone.FullRoi"]
                        </MudText>
                        <MudText Typo="Typo.caption" Class="sv-text-muted">
                            @L["Wizard.StepZone.FullRoiHint"]
                        </MudText>
                    </div>
                    @if (fullRoiPicked)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                 Style="color:var(--mud-palette-primary);" />
                    }
                </MudStack>
            </MudPaper>

            @* Karty: istniejące strefy w wybranym ROI *@
            @foreach (var zone in zonesInRoi)
            {
                var zonePicked = _zoneMode == ZoneMode.Existing && _selectedZoneId == zone.Id;
                <MudPaper Elevation="0"
                          Style="@($"cursor:pointer; border:2px solid {(zonePicked ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)")}; border-radius:6px; padding:14px;")"
                          @onclick="@(() => { _zoneMode = ZoneMode.Existing; _selectedZoneId = zone.Id; })">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Fence" Size="Size.Large"
                                 Style="@($"color:{(zonePicked ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)")};")" />
                        <div style="flex:1;">
                            <MudText Typo="Typo.body1" Style="@(zonePicked ? "font-weight:600;" : "")">@zone.Name</MudText>
                            <MudText Typo="Typo.caption" Class="sv-text-muted">
                                @zone.Polygon.Count @L["Wizard.StepZone.Vertices"]
                            </MudText>
                            @if (zone.TriggerIds.Count > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="mt-1">
                                    @string.Format(L["Wizard.StepZone.AlreadyHasTriggers"], zone.TriggerIds.Count)
                                </MudChip>
                            }
                        </div>
                        <div @onclick:stopPropagation="true" style="display:flex; gap:4px; align-items:center;">
                            <MudTooltip Text="@L["Common.Edit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditZoneAsync(zone))" />
                            </MudTooltip>
                            @if (zonePicked)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                         Style="color:var(--mud-palette-primary);" />
                            }
