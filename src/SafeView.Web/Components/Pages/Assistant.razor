@page "/assistant"
@attribute [Authorize(Policy = "perm:llm:chat")]
@inject SafeView.Application.Abstractions.LLM.IChatClient Chat
@inject SafeView.Application.Abstractions.Persistence.IIncidentRepository IncidentRepo
@inject SafeView.Application.Abstractions.Persistence.ICameraRepository CameraRepo
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@rendermode InteractiveServer

<PageTitle>@L["Assistant.Title"] — @L["AppName"]</PageTitle>

<MudStack Spacing="3" Style="height: calc(100vh - 140px);">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">@L["Assistant.Title"]</MudText>
        <MudChip T="string" Size="Size.Small" Class="sv-chip-info">@Chat.Backend</MudChip>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.NetworkPing" OnClick="Ping" Variant="Variant.Outlined" Size="Size.Small">
            Test połączenia
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="Reset" Variant="Variant.Outlined" Size="Size.Small">
            Wyczyść
        </MudButton>
    </MudStack>

    <MudPaper Class="pa-3 sv-card" Elevation="0" Style="flex:1; overflow-y:auto;">
        @if (_messages.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="sv-text-muted">
                Asystent ma kontekst: ostatnich @_lastIncidentCount incydentów + listę kamer.
                Zapytaj np. „Ile było alarmów PPE w ostatniej dobie?" lub „Streszcz najpoważniejsze incydenty z dziś".
            </MudText>
        }
        @foreach (var m in _messages.Where(m => m.Role != SafeView.Application.Abstractions.LLM.ChatRole.System))
        {
            var isUser = m.Role == SafeView.Application.Abstractions.LLM.ChatRole.User;
            <div style="margin: 8px 0; display:flex; justify-content:@(isUser ? "flex-end" : "flex-start");">
                <div style="max-width:80%; padding:10px 14px; border-radius:10px;
                            background:@(isUser ? "#1B2A3A" : "#16181D");
                            color:@(isUser ? "#E6F1FF" : "#DDD");
                            white-space:pre-wrap; word-wrap:break-word;">
                    @m.Content
                </div>
            </div>
        }
        @if (_busy)
        {
            <div class="sv-text-muted" style="margin: 8px 0;"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> Asystent odpowiada…</div>
        }
    </MudPaper>

    <MudStack Row="true" Spacing="2">
        <MudTextField @bind-Value="_input" Placeholder="Wpisz pytanie…" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Immediate="true"
                      OnKeyDown="OnKey" Disabled="_busy" Style="flex:1;" />
        <MudButton StartIcon="@Icons.Material.Filled.Send" OnClick="Send" Color="Color.Primary"
                   Variant="Variant.Filled" Disabled="_busy || string.IsNullOrWhiteSpace(_input)">
            Wyślij
        </MudButton>
    </MudStack>
</MudStack>

@code {
    private readonly List<SafeView.Application.Abstractions.LLM.ChatMessage> _messages = new();
    private string _input = string.Empty;
    private bool _busy;
    private int _lastIncidentCount;

    protected override async Task OnInitializedAsync()
    {
        await BuildSystemContextAsync();
    }

    private async Task BuildSystemContextAsync()
    {
        var incidents = (await IncidentRepo.ListRecentAsync(50)).ToList();
        var cameras = (await CameraRepo.ListAsync()).ToList();
        _lastIncidentCount = incidents.Count;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Jesteś asystentem BHP w systemie SafeView (monitoring kamer + ML).");
        sb.AppendLine("Odpowiadasz po polsku, zwięźle, faktograficznie. Korzystasz wyłącznie z danych kontekstu.");
        sb.AppendLine("Jeżeli pytanie wykracza poza dane — powiedz to wprost.");
        sb.AppendLine();
        sb.AppendLine($"## Kamery ({cameras.Count})");
        foreach (var c in cameras.Take(50))
            sb.AppendLine($"- {c.Name} (id:{c.Id}) — {c.Location ?? "—"} — enabled:{c.Enabled}");
        sb.AppendLine();
        sb.AppendLine($"## Ostatnie incydenty ({incidents.Count})");
        foreach (var i in incidents)
            sb.AppendLine($"- {i.OccurredAt:yyyy-MM-dd HH:mm} · {i.Severity} · {i.Category} · cam={i.CameraName} · status={i.Status} · {i.Summary}");

        _messages.Clear();
        _messages.Add(new SafeView.Application.Abstractions.LLM.ChatMessage(
            SafeView.Application.Abstractions.LLM.ChatRole.System, sb.ToString()));
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_input) || _busy) return;
        var question = _input.Trim();
        _input = string.Empty;
        _messages.Add(new SafeView.Application.Abstractions.LLM.ChatMessage(
            SafeView.Application.Abstractions.LLM.ChatRole.User, question));
        _busy = true;
        StateHasChanged();
        try
        {
            var resp = await Chat.ChatAsync(_messages);
            if (!resp.Success)
            {
                Snackbar.Add($"Błąd LLM: {resp.ErrorMessage}", Severity.Error);
                _messages.Add(new SafeView.Application.Abstractions.LLM.ChatMessage(
                    SafeView.Application.Abstractions.LLM.ChatRole.Assistant,
                    $"[BŁĄD] {resp.ErrorMessage}"));
            }
            else
            {
                _messages.Add(new SafeView.Application.Abstractions.LLM.ChatMessage(
                    SafeView.Application.Abstractions.LLM.ChatRole.Assistant, resp.Content));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await Send();
    }

    private async Task Reset()
    {
        await BuildSystemContextAsync();
        Snackbar.Add("Kontekst odświeżony.", Severity.Info);
    }

    private async Task Ping()
    {
        var ok = await Chat.PingAsync();
        Snackbar.Add(ok ? $"OK ({Chat.Backend})" : $"Brak połączenia ({Chat.Backend})",
            ok ? Severity.Success : Severity.Error);
    }
}
