@inject IStringLocalizer<SharedResource> L

<MudNavMenu Class="pa-2">
    @* ── Operator — codzienna praca ──────────────────────── *@
    <MudNavGroup Title="@L["Nav.Group.Operator"]" Icon="@Icons.Material.Filled.Visibility" Expanded="true">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@L["Nav.Dashboard"]</MudNavLink>
        <MudNavLink Href="/monitor" Icon="@Icons.Material.Filled.Videocam">@L["Nav.Monitor"]</MudNavLink>
        <MudNavLink Href="/flow" Icon="@Icons.Material.Filled.AccountTree">@L["Nav.Flow"]</MudNavLink>
        <MudNavLink Href="/incidents" Icon="@Icons.Material.Filled.Warning">@L["Nav.Incidents"]</MudNavLink>
    </MudNavGroup>

    @* ── Ustawienia — typowy operator BHP konfiguruje tylko tutaj ─────── *@
    <MudNavGroup Title="@L["Nav.Group.Settings"]" Icon="@Icons.Material.Filled.Tune" Expanded="true">
        <MudNavLink Href="/setup-wizard" Icon="@Icons.Material.Filled.AutoFixHigh"
                    Style="font-weight:600;">
            @L["Nav.SetupWizard"]
        </MudNavLink>
        <MudNavLink Href="/admin/detection-classes" Icon="@Icons.Material.Filled.Category">@L["Nav.WhatToDetect"]</MudNavLink>
        <MudNavLink Href="/admin/actions" Icon="@Icons.Material.Filled.FlashOn">@L["Nav.Actions"]</MudNavLink>
    </MudNavGroup>

    @* ── Zaawansowane — IT/technik: kamery, pipeline, ML models, LLM ─── *@
    <MudNavGroup Title="@L["Nav.Group.Advanced"]" Icon="@Icons.Material.Filled.Engineering" Expanded="false">
        <MudNavLink Href="/cameras" Icon="@Icons.Material.Filled.CameraAlt">@L["Nav.Cameras"]</MudNavLink>
        <MudNavLink Href="/admin/rois" Icon="@Icons.Material.Filled.CropFree">@L["Nav.Rois"]</MudNavLink>
        <MudNavLink Href="/zones" Icon="@Icons.Material.Filled.Fence">@L["Nav.Zones"]</MudNavLink>
        <MudNavLink Href="/admin/triggers" Icon="@Icons.Material.Filled.FlashAuto">@L["Nav.Triggers"]</MudNavLink>
        <MudNavLink Href="/models" Icon="@Icons.Material.Filled.Memory">@L["Nav.Models"]</MudNavLink>
        <MudNavLink Href="/admin/vllm-templates" Icon="@Icons.Material.Filled.TipsAndUpdates">@L["Nav.VllmTemplates"]</MudNavLink>
        <MudNavLink Href="/admin/vllm-playground" Icon="@Icons.Material.Filled.Science">@L["Nav.VllmPlayground"]</MudNavLink>
        <MudNavLink Href="/admin/llm-chat" Icon="@Icons.Material.Filled.Chat">@L["Nav.LlmChat"]</MudNavLink>
        <MudNavLink Href="/admin/llm-providers" Icon="@Icons.Material.Filled.Hub">@L["Nav.LlmProviders"]</MudNavLink>
        <MudNavLink Href="/admin/mediamtx" Icon="@Icons.Material.Filled.Stream">@L["Nav.MediaMtx"]</MudNavLink>
        <MudNavLink Href="/admin/settings" Icon="@Icons.Material.Filled.Settings">@L["Nav.Settings"]</MudNavLink>
    </MudNavGroup>

    @* ── Administracja — użytkownicy, bezpieczeństwo, diagnostyka ───── *@
    <MudNavGroup Title="@L["Nav.Group.Administration"]" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
        <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">@L["Nav.Users"]</MudNavLink>
        <MudNavLink Href="/api-keys" Icon="@Icons.Material.Filled.Key">@L["Nav.ApiKeys"]</MudNavLink>
        <MudNavLink Href="/license" Icon="@Icons.Material.Filled.VpnKey">@L["Nav.License"]</MudNavLink>
        <MudNavLink Href="/audit" Icon="@Icons.Material.Filled.History">@L["Nav.AuditLog"]</MudNavLink>
        <MudNavLink Href="/admin/actions/history" Icon="@Icons.Material.Filled.ReceiptLong">@L["Nav.ActionHistory"]</MudNavLink>
        <MudNavLink Href="/admin/system-events" Icon="@Icons.Material.Filled.BugReport">@L["Nav.SystemEvents"]</MudNavLink>
        <MudNavLink Href="/admin/performance" Icon="@Icons.Material.Filled.Speed">@L["Nav.Performance"]</MudNavLink>
        <MudNavLink Href="/swagger" Icon="@Icons.Material.Filled.Api" Target="_blank">@L["Nav.ApiDocs"]</MudNavLink>
    </MudNavGroup>
</MudNavMenu>
