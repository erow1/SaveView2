@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<MudMenu Icon="@Icons.Material.Filled.Language" Color="Color.Inherit"
         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
         Label="@CurrentLabel" AriaLabel="Language">
    <MudMenuItem OnClick="@(() => SetCulture("pl"))">
        <div style="display:inline-flex; align-items:center; gap:8px;">
            @FlagPl
            <span>@L["Language.Polish"]</span>
        </div>
    </MudMenuItem>
    <MudMenuItem OnClick="@(() => SetCulture("en"))">
        <div style="display:inline-flex; align-items:center; gap:8px;">
            @FlagEn
            <span>@L["Language.English"]</span>
        </div>
    </MudMenuItem>
</MudMenu>

@code {
    private string CurrentLabel => System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToUpperInvariant();

    private void SetCulture(string culture)
    {
        var uri = new Uri(Nav.Uri).GetComponents(UriComponents.PathAndQuery, UriFormat.Unescaped);
        var target = $"/culture/set?culture={culture}&redirect={Uri.EscapeDataString(uri)}";
        Nav.NavigateTo(target, forceLoad: true);
    }

    // Flat SVG flags — 20×14 with 2px rounded corners
    private static readonly RenderFragment FlagPl = builder =>
    {
        builder.AddMarkupContent(0,
            @"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 20 14"" width=""20"" height=""14"" style=""border-radius:2px; flex-shrink:0;"">
                <rect width=""20"" height=""7"" fill=""#fff""/>
                <rect y=""7"" width=""20"" height=""7"" fill=""#dc143c""/>
            </svg>");
    };

    private static readonly RenderFragment FlagEn = builder =>
    {
        builder.AddMarkupContent(0,
            @"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 20 14"" width=""20"" height=""14"" style=""border-radius:2px; flex-shrink:0;"">
                <rect width=""20"" height=""14"" fill=""#012169""/>
                <path d=""M0,0 L20,14 M20,0 L0,14"" stroke=""#fff"" stroke-width=""2.8""/>
                <path d=""M0,0 L20,14 M20,0 L0,14"" stroke=""#C8102E"" stroke-width=""1.4""/>
                <path d=""M10,0 V14 M0,7 H20"" stroke=""#fff"" stroke-width=""4""/>
                <path d=""M10,0 V14 M0,7 H20"" stroke=""#C8102E"" stroke-width=""2.4""/>
            </svg>");
    };
}
