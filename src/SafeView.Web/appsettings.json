{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "safeview"
  },
  "MediaMtx": {
    "Enabled": true,
    "AutoStart": true,
    "BinaryPath": null,
    "ConfigDirectory": null,
    "ReconcileIntervalSeconds": 30,
    "Host": "localhost",
    "RtspPort": 8554,
    "HlsPort": 8888,
    "RtspUrlTemplate": "rtsp://{host}:{port}/{path}",
    "HlsUrlTemplate": "http://{host}:{port}/{path}/index.m3u8"
  },
  "Ffmpeg": {
    "BinaryPath": null,
    "TimeoutSeconds": 15,
    "RtspTransport": "tcp"
  },
  "Cameras": {
    "Sampler": {
      "Enabled": true,
      "MinTickMilliseconds": 250,
      "MaxConcurrentCaptures": 4,
      "StartupDelaySeconds": 5
    }
  },
  "License": {
    "FilePath": "storage/licenses/safeview.lic",
    "RevalidateIntervalMinutes": 60,
    "ExpiryWarningDays": 30,
    "AllowReadOnlyOnInvalid": true,
    "DevBypass": true
  },
  "Llm": {
    "Backend": "openai",
    "BaseUrl": "http://localhost:8000/v1",
    "ApiKey": null,
    "DefaultModel": "gpt-4o-mini",
    "TimeoutSeconds": 60
  },
  "Notifications": {
    "MinSeverity": 1,
    "Smtp": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 25,
      "UseStartTls": false,
      "Username": null,
      "Password": null,
      "From": "safeview@localhost",
      "To": [],
      "SubjectTemplate": "[SafeView] {severity} — {category} @ {camera}"
    },
    "Webhooks": [],
    "Digest": {
      "Enabled": true,
      "HourUtc": 6,
      "MinuteUtc": 0
    }
  },
  "Storage": {
    "Root": "storage",
    "Frames": "frames",
    "Clips": "clips",
    "Reports": "reports",
    "Models": "models",
    "Uploads": "uploads",
    "Licenses": "licenses"
  },
  "Diagnostics": {
    "Enabled": true,
    "MinimumLevel": 2,
    "RetentionDays": 7,
    "MaxStackTraceLength": 8192
  },
  "ML": {
    "UseGpu": false,
    "GpuDeviceId": 0,
    "FallbackProvider": ""
  }
}
